
<div class="cafe-container">

  <!-- Cafe Header -->
  <header>
    <h1>☕ Ars Cafe and Meeting House</h1>

    <p class="tagline">
      Good Coffee. Great Conversations. A Place to Gather.
    </p>

    <p class="cafe-description">
      Welcome to Ars Cafe and Meeting House!
      Our cafe is a cozy and welcoming place to enjoy
      freshly brewed coffee, relax by the fireplace,
      study, or spend time with friends and family.
      Whether you are stopping in for your morning
      coffee or meeting friends in the evening,
      there is always a place for you at Ars Cafe.
    </p>
  </header>

  <!-- Day and Night Toggle -->
  <button id="toggle-mode" type="button">
    Toggle Day/Night Mode
  </button>

  <!-- Cafe Interior Photos -->
  <section class="cafe-photo-section">

    <h2>Take a Look Inside</h2>

    <p>
      Experience the warm and welcoming atmosphere
      of Ars Cafe during the day and at night!
    </p>

    <img
      id="cafe-img"
      src="https://raw.githubusercontent.com/USERNAME/REPOSITORY/main/Day-Time%20Cafe.jpg"
      alt="Inside Ars Cafe during the day"
    >

    <p id="photo-caption">
      A bright and welcoming place to start your day.
    </p>

  </section>

  <!-- Cafe Menu -->
  <section class="menu">

    <h2>Our Menu</h2>

    <p>Check out some of our customer favorites!</p>

    <ul id="menu-list"></ul>

  </section>

  <!-- Daily Special Generator -->
  <section class="special-section">

    <h2>☕ Feeling Lucky?</h2>

    <p>
      Not sure what to order?
      Let us choose something for you!
    </p>

    <button id="show-special" type="button">
      Show Daily Special
    </button>

    <p id="daily-special" aria-live="polite"></p>

  </section>

  <!-- Footer -->
  <footer>
    <p>Ars Cafe and Meeting House</p>
    <p>Good Coffee. Great Company. ☕</p>
  </footer>

</div>
